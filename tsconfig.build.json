  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.mts",
    "src/**/*.ts",
    "packages/**/*.mts"
  ],
  "exclude": ["dist", "node_modules", "test"]
}
