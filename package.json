{
  "name": "@soda_game/orbit-cli",
  "version": "0.2.3",
  "description": "Open-source local CLI and Web CLI for Orbit Arcade",
  "type": "module",
  "license": "MIT",
  "author": "SODA GAME",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soda-game-org/orbit-cli.git"
  },
  "bugs": {
    "url": "https://github.com/soda-game-org/orbit-cli/issues"
  },
  "homepage": "https://github.com/soda-game-org/orbit-cli#readme",
  "keywords": [
    "orbit",
    "arcade",
    "cli",
    "game-development"
  ],
  "private": false,
  "workspaces": [
    "packages/orbit-agent-core",
    "packages/orbit-provider-core"
  ],
  "bin": {
    "orbit": "dist/src/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "RELEASES.md",
    "SECURITY.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.mts",
    "build:provider-core": "tsc -p packages/orbit-provider-core/tsconfig.json",
    "typecheck": "npm run build:provider-core --silent && tsc -p tsconfig.json",
    "test": "tsx scripts/build.mts && tsx --test test/*.test.mts",
    "build": "tsx scripts/build.mts",
    "audit:public": "tsx scripts/audit-public.mts",
    "check": "npm run typecheck && npm run test && npm run audit:public",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@soda_game/orbit-agent-core": "0.5.2",
    "@soda_game/orbit-provider-core": "0.3.2",
    "@supabase/supabase-js": "^2.105.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
